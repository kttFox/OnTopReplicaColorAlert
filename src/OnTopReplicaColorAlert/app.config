<?xml version="1.0"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="OnTopReplicaColorAlert.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
        </sectionGroup>
    </configSections>
  
    <userSettings>
      <OnTopReplicaColorAlert.Properties.Settings>
       <setting name="Opacity" serializeAs="String">
        <value>255</value>
       </setting>
       <setting name="Language" serializeAs="String">
        <value>(Default)</value>
       </setting>
       <setting name="ClickThrough" serializeAs="String">
        <value>True</value>
       </setting>
       <setting name="FirstTimeClickThrough" serializeAs="String">
        <value>True</value>
       </setting>
      </OnTopReplicaColorAlert.Properties.Settings>
    </userSettings>

  <!-- Runtiome support declaration -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>

  <!-- Windows Forms configuration for .NET 4.7 -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2"/>
  </System.Windows.Forms.ApplicationConfigurationSection>

</configuration>
